# StudySmart Environment Configuration
# Copy this file to .env and fill in your actual keys

# ===========================================
# OPENAI API CONFIGURATION
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# ===========================================
# SMS/WHATSAPP OTP CONFIGURATION (Optional)
# ===========================================
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Choose SMS service: twilio, africastalking, or clicksend
SMS_SERVICE=twilio

# Africa's Talking (Alternative for Africa)
# Get from: https://africastalking.com/
AT_USERNAME=sandbox
AT_API_KEY=YOUR_AT_API_KEY
AT_SHORTCODE=YOUR_SHORTCODE

# ClickSend (Alternative Global SMS)
# Get from: https://www.clicksend.com/
CLICKSEND_USERNAME=YOUR_USERNAME
CLICKSEND_API_KEY=YOUR_API_KEY

# ===========================================
# APPLICATION SETTINGS
# ===========================================
# Debug mode: true for development, false for production
DEBUG_MODE=true

# Application URL
APP_URL=http://localhost:8000
