# StudySmart Environment Configuration
# Copy this file to .env and fill in your actual keys

# ===========================================
# OPENAI API CONFIGURATION
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# ===========================================
# SMS/WHATSAPP OTP CONFIGURATION (Optional)
# ===========================================
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Choose SMS service: twilio, africastalking, or clicksend
SMS_SERVICE=twilio

# Africa's Talking (Alternative for Africa)
# Get from: https://africastalking.com/
AT_USERNAME=sandbox
AT_API_KEY=YOUR_AT_API_KEY
AT_SHORTCODE=YOUR_SHORTCODE

# ClickSend (Alternative Global SMS)
# Get from: https://www.clicksend.com/
CLICKSEND_USERNAME=YOUR_USERNAME
CLICKSEND_API_KEY=YOUR_API_KEY

# ===========================================
# APPLICATION SETTINGS
# ===========================================
# Debug mode: true for development, false for production
DEBUG_MODE=true

# Application URL
APP_URL=http://localhost:8000

# ===========================================
# GOOGLE ADSENSE CONFIGURATION (Optional)
# ===========================================
# Get your Publisher ID from: https://www.google.com/adsense
# Format: ca-pub-XXXXXXXXXXXXXX
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-YOUR_ADSENSE_ID_HERE

# Enable/disable AdSense ads
GOOGLE_ADSENSE_ENABLED=false

# ===========================================
# PAYFAST PAYMENT GATEWAY CONFIGURATION
# ===========================================
# Get your merchant credentials from: https://www.payfast.io/
# For sandbox/testing: https://sandbox.payfast.co.za/

# Merchant ID (provided by PayFast)
PAYFAST_MERCHANT_ID=YOUR_MERCHANT_ID

# Merchant Key (provided by PayFast)
PAYFAST_MERCHANT_KEY=YOUR_MERCHANT_KEY

# Passphrase (optional but recommended for added security)
PAYFAST_PASSPHRASE=YOUR_PASSPHRASE

# Use sandbox mode (true for testing, false for production)
PAYFAST_SANDBOX=true

# ===========================================
# BOBPAY PAYMENT GATEWAY CONFIGURATION
# ===========================================
# Get your API key from: https://bobpay.co.za/ or your payment provider
# BobPay is integrated as an alternative payment gateway for subscriptions

# BobPay API Key (Bearer token for API authentication)
# Your API key: 8ce***0c1
BOBPAY_API_KEY=8ce2a14c44f6426486304bb8a7ff90c1

# BobPay Passphrase (from BobPay dashboard - used for webhook signature verification)
# Copy the passphrase you set in the BobPay dashboard
BOBPAY_PASSPHRASE=1DF0wpbaTV

# Use sandbox mode (true for testing, false for production)
BOBPAY_SANDBOX=true

# ===========================================
